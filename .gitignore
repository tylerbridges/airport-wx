node_modules/
.DS_Store
# raw response samples written by poller/poll.mjs; the workflow copies them to the history branch
.cache/
# local checkout of the history branch (the workflow uses ./history)
/history/
# generated each poll run by poller/global.mjs (build2a)
site/data/wx/
# generated by poller/poll.mjs (trips hook); airports and times only
site/data/trips.json
# generated by poller/changes.mjs on every run (brief hook)
